{
  "name": "zbrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bun-compiled CLI for workspace-isolated personal LLM wiki workflows.",
  "scripts": {
    "generate:assets": "node scripts/generate-bundled-assets.mjs",
    "build": "bun run build.ts",
    "test": "bun test --run",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "latest",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/bun": "latest",
    "typescript": "^5.7.3",
    "vitest": "^1.6.1"
  }
}
